# ==============================================================================
# Enterprise Bug Risk Intelligence & Automated Resolution Platform (v2.0)
# Environment Configuration Template
# ==============================================================================

# Application Environment (development / staging / production)
ENVIRONMENT=production

# Backend Service Configuration
PORT=8000
HOST=0.0.0.0
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:8000"]

# Database & SQLite State Storage
DATABASE_PATH=sqlite:///./database.db

# JWT & Authentication Secret Keys (Generate a 64-char hex key for production)
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-256-bit
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default / Fallback AI Provider API Keys (Optional - Users can configure per session)
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
